#!/usr/bin/env bash
# design-doc-open <doc>: print the doc's path and, when this session runs in
# tmux, show the doc in the running Emacs: a terminal frame in a new
# background window of this tmux session, so that the doc sits beside the
# session that wrote it. The second line of output says what was done. The
# exit status is 0 unless the arguments are wrong.
set -u

emacsclient=${DESIGN_DOC_OPEN_EMACSCLIENT:-emacsclient}
tmux=${DESIGN_DOC_OPEN_TMUX:-tmux}
# With this set, emacsclient starts another editor when no server answers.
unset ALTERNATE_EDITOR

if [ $# -ne 1 ]; then
  echo "usage: design-doc-open <doc>" >&2
  exit 2
fi
if [ ! -f "$1" ]; then
  echo "design-doc-open: no such file: $1" >&2
  exit 2
fi
file=$(realpath -- "$1")
echo "$file"

if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
  echo "not opened: this session is outside tmux"
  exit 0
fi

# Ask the server whether a window already shows the doc. No answer means
# that no server runs.
lisp_file=${file//\\/\\\\}
lisp_file=${lisp_file//\"/\\\"}
shown=$(timeout 5 "$emacsclient" -e \
  "(let ((b (find-buffer-visiting \"$lisp_file\"))) (and b (get-buffer-window b t) t))" \
  2>/dev/null) || {
  echo "not opened: no Emacs server answers"
  exit 0
}
if [ "$shown" = t ]; then
  echo "not opened: an Emacs window already shows it"
  exit 0
fi

name=$(basename -- "$file" .org)
session=$("$tmux" display-message -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null)
# Several arguments, so that tmux runs the command without a shell.
if window=$("$tmux" new-window -d -P -F '#{window_index}' -t "$session:" -n "$name" -- \
  "$(command -v env)" -u ALTERNATE_EDITOR "$(command -v "$emacsclient")" -t -- "$file" \
  2>/dev/null); then
  echo "opened in window $window ($name) of this tmux session, in the background"
else
  echo "not opened: tmux made no window"
fi
exit 0
